# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
# Port for the API (defaults to 5002 to avoid clashing with other local services).
REPORTING_API_PORT=5002
# Comma-separated browser origins allowed to call the API directly (not needed when the
# frontend proxies /api, e.g. the Vercel rewrite or the Vite dev proxy).
CORS_ORIGIN=https://your-frontend.example.com

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production, min 16 chars each, random)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Reporting administration database (users, roles, platform configuration, audit logs).
# This is NOT the platforms' production data — reporting data is fetched from each
# platform's API.
# ---------------------------------------------------------------------------
REPORTING_STORE=postgres
# Replace the placeholders. Angle brackets make the URL invalid and the server will not start.
# Local Postgres (SSL off): postgresql://postgres:password@localhost:5432/newadmin
# Hosted Postgres: add ?sslmode=require
REPORTING_DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require


# First Super Admin, created only when the users collection is empty.
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Platform API integrations
# ---------------------------------------------------------------------------
# 32-byte key used to encrypt platform API credentials at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes previously saved credentials unreadable (re-enter them in the wizard).
INTEGRATION_SECRET_KEY=

# Approved outbound API hosts (comma separated, supports *.example.com, host:port).
# Super Admins can add more under Settings → Approved API hosts.
OUTBOUND_ALLOWED_HOSTS=ghsuperwinnings.com


# Development only: explicit private/loopback and plain-HTTP exceptions (host:port).
OUTBOUND_ALLOW_PRIVATE_HOSTS=
OUTBOUND_ALLOW_HTTP_HOSTS=

# Optional tuning
OUTBOUND_DEFAULT_TIMEOUT_MS=15000
OUTBOUND_MAX_RESPONSE_BYTES=5242880
OUTBOUND_CACHE_TTL_MS=30000
EXPORT_MAX_RECORDS=50000
EXPORT_MAX_PAGES=500
